{
  "expo": {
    "name": "Sistema Cafeto",
    "slug": "sistema-cafeto-movil",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/cafeto-icono-ambar@512.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#121128",
        "foregroundImage": "./assets/cafeto-icono-ambar@512.png",
        "monochromeImage": "./assets/cafeto-icono-blanco@512.png"
      }
    },
    "web": {
      "favicon": "./assets/cafeto-favicon-32.png"
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-status-bar",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Cafeto usa la cámara para leer el código de barras de los productos.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
